extends Node2D

# Путь к сцене первого уровня. Игра целиком живёт в этой одной сцене -
# после 12-го "сюжетного" уровня level.gd сам переходит на процедурно
# генерируемые эндлесс-уровни (см. level.gd::generate_procedural_level()),
# поэтому отдельной сцены "эндлесс-режима" запускать не нужно - обычный
# level1.tscn покрывает и сюжет, и бесконечную часть игры.
const LEVEL_SCENE_PATH := "res://levels/level1.tscn"


func _ready() -> void:
	# Главное меню - самое начало запуска игры, поэтому имеет смысл
	# держать курсор видимым и не зависеть от состояния, оставшегося
	# от предыдущей игры (на случай возврата в меню в будущем).
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE


func _on_play_button_pressed() -> void:
	# Полный сброс прогресса перед стартом: Main - автозагрузка и не
	# пересоздаётся между сессиями, без reset_game() вторая партия за
	# один запуск игры началась бы с деньгами/уроном/скиллами,
	# оставшимися от предыдущего прохождения.
	Main.reset_game()
	get_tree().change_scene_to_file(LEVEL_SCENE_PATH)


func _on_exit_button_pressed() -> void:
	get_tree().quit()
